    <!-- CONTACT -->
    <section class="page" id="contact">

        <div class="title">

            <h2>Contact Us</h2>

            <p>
                Send us a message
            </p>

        </div>

        <div class="contact-container">

            <form class="contact-form" onsubmit="sendMessage(event)">

                <div class="input-box">

                    <label>Name</label>

                    <input
                        type="text"
                        id="name"
                        placeholder="Enter your name"
                        required
                    >

                </div>


                <div class="input-box">

                    <label>Email</label>

                    <input
                        type="email"
                        placeholder="Enter your email"
                        required
                    >

                </div>


                <div class="input-box">

                    <label>Message</label>

                    <textarea
                        placeholder="Write your message..."
                        required
                    ></textarea>

                </div>


                <button class="submit-btn" type="submit">
                    Send Message
                </button>

            </form>

        </div>

    </section>


    <!-- FOOTER -->
    <footer>

        <h3>TechZone</h3>

        <p>© 2026 TechZone. All Rights Reserved.</p>

        <div class="social">

            <a href="#">Facebook</a>
            <a href="#">Instagram</a>
            <a href="#">YouTube</a>

        </div>

    </footer>


    <!-- LOGIN PAGE -->
    <section class="auth-page" id="loginPage">
        <div class="auth-box">
            <h2>Login</h2>
            <p class="auth-subtitle">Login to open TechZone</p>

            <form onsubmit="loginUser(event)">
                <div class="input-box">
                    <label>Email</label>
                    <input type="email" id="loginEmail"
                           placeholder="Enter your email" required>
                </div>

                <div class="input-box">
                    <label>Password</label>
                    <input type="password" id="loginPassword"
                           placeholder="Enter your password" required>
                </div>

                <button class="auth-submit" type="submit">
                    Login
                </button>
            </form>

            <div class="auth-divider">OR</div>

            <button class="google-btn" onclick="continueWithGoogle()">
                🔵 Continue with Google
            </button>

            <p class="auth-switch">
                Don't have an account?
                <a onclick="showAuthPage('signup')">Sign Up</a>
            </p>
        </div>
    </section>


    <!-- SIGN UP PAGE -->
    <section class="auth-page" id="signupPage">
        <div class="auth-box">
            <h2>Create Account</h2>
            <p class="auth-subtitle">Sign up to access TechZone</p>

            <form onsubmit="signupUser(event)">
                <div class="input-box">
                    <label>Full Name</label>
                    <input type="text" id="signupName"
                           placeholder="Enter your name" required>
                </div>

                <div class="input-box">
                    <label>Email</label>
                    <input type="email" id="signupEmail"
                           placeholder="Enter your email" required>
                </div>

                <div class="input-box">
                    <label>Password</label>
                    <input type="password" id="signupPassword"
                           placeholder="Create a password" minlength="6" required>
                </div>

                <div class="input-box">
                    <label>Confirm Password</label>
                    <input type="password" id="signupConfirm"
                           placeholder="Confirm your password" minlength="6" required>
                </div>

                <button class="auth-submit" type="submit">
                    Create Account
                </button>
            </form>

            <div class="auth-divider">OR</div>

            <button class="google-btn" onclick="continueWithGoogle()">
                🔵 Continue with Google
            </button>

            <p class="auth-switch">
                Already have an account?
                <a onclick="showAuthPage('login')">Login</a>
            </p>

            <p class="auth-note">
                Google button is a demo OAuth-style flow. Real Google authentication
                requires Google OAuth credentials and a backend.
            </p>
        </div>
    </section>


    <!-- LOGIN MODAL -->
    <div class="modal" id="loginModal">

        <div class="login-box">

            <span class="close" onclick="closeLogin()">×</span>

            <h2>Login</h2>

            <form onsubmit="login(event)">

                <div class="input-box">

                    <label>Email</label>

                    <input
                        type="email"
                        placeholder="Enter email"
                        required
                    >

                </div>


                <div class="input-box">

                    <label>Password</label>

                    <input
                        type="password"
                        placeholder="Enter password"
                        required
                    >

                </div>


                <button class="submit-btn">
                    Login
                </button>

            </form>

        </div>

    </div>


    <!-- JAVASCRIPT -->
    <script>

        // ALL SERVICE IDs USED BY THE WEBSITE
        const serviceIds = [
            "web-development",
            "web-design",
            "responsive-design",
            "ui-ux-design",
            "ecommerce",
            "website-maintenance",
            "seo",
            "landing-page",
            "javascript"
        ];

        // AUTHENTICATION
        function getUsers() {
            return JSON.parse(localStorage.getItem("techzoneUsers") || "[]");
        }

        function saveUsers(users) {
            localStorage.setItem("techzoneUsers", JSON.stringify(users));
        }

        function isLoggedIn() {
            return localStorage.getItem("techzoneLoggedIn") === "yes";
        }

        function showAuthPage(type) {
            // Close old login modal if it is open
            closeLogin();

            document.querySelectorAll(".page").forEach(function(page) {
                page.classList.remove("active-page");
            });

            document.querySelectorAll(".service-page").forEach(function(page) {
                page.classList.remove("active-service");
            });

            document.querySelectorAll(".auth-page").forEach(function(page) {
                page.classList.remove("active-auth");
            });

            const page = document.getElementById(
                type === "signup" ? "signupPage" : "loginPage"
            );

            if (page) {
                page.classList.add("active-auth");
            }

            document.getElementById("navbar").classList.remove("active");

            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });
        }

        function openWebsiteAfterLogin(name) {
            localStorage.setItem("techzoneLoggedIn", "yes");
            localStorage.setItem("techzoneCurrentUser", name || "User");

            // Remove auth screens and open Home
            document.querySelectorAll(".auth-page").forEach(function(page) {
                page.classList.remove("active-auth");
            });

            showPage("home");

            alert("Welcome " + (name || "User") + "! Website opened successfully. ✅");
        }

        function signupUser(event) {
            event.preventDefault();

            const name = document.getElementById("signupName").value.trim();
            const email = document.getElementById("signupEmail").value.trim().toLowerCase();
            const password = document.getElementById("signupPassword").value;
            const confirm = document.getElementById("signupConfirm").value;

            if (password !== confirm) {
                alert("Passwords do not match!");
                return;
            }

            if (password.length < 6) {
                alert("Password must be at least 6 characters.");
                return;
            }

            const users = getUsers();

            if (users.some(function(user) {
                return user.email === email;
            })) {
                alert("This email is already registered. Please Login.");
                showAuthPage("login");
                document.getElementById("loginEmail").value = email;
                return;
            }

            users.push({
                name: name,
                email: email,
                password: password
            });

            saveUsers(users);

            alert("Account created successfully! Now login to open the website. ✅");

            document.getElementById("signupEmail").value = "";
            document.getElementById("signupPassword").value = "";
            document.getElementById("signupConfirm").value = "";

            showAuthPage("login");
            document.getElementById("loginEmail").value = email;
        }

        function loginUser(event) {
            event.preventDefault();

            const email = document.getElementById("loginEmail").value.trim().toLowerCase();
            const password = document.getElementById("loginPassword").value;

            const users = getUsers();

            const user = users.find(function(item) {
                return item.email === email && item.password === password;
            });

            if (!user) {
                alert("Invalid email or password. Please Sign Up first.");
                return;
            }

            openWebsiteAfterLogin(user.name);
        }

        function continueWithGoogle() {
            /*
             * DEMO ONLY:
             * A real Google sign-in needs Google OAuth Client ID,
             * redirect URI and backend/token verification.
             * This button simulates a successful Google login locally.
             */
            const googleName = prompt(
                "Demo Google Login\\nEnter the Google account name:"
            );

            if (!googleName || !googleName.trim()) {
                return;
            }

            openWebsiteAfterLogin(googleName.trim());
        }

        function logoutUser() {
            localStorage.removeItem("techzoneLoggedIn");
            localStorage.removeItem("techzoneCurrentUser");
            showAuthPage("login");
        }

        // SERVICE DETAILS
        function showService(serviceId) {

            // Service pages require login.
            if (!isLoggedIn()) {
                showAuthPage("login");
                return;
            }

            // Hide normal pages
            document.querySelectorAll(".page").forEach(function(page) {
                page.classList.remove("active-page");
            });

            // Hide every service page
            document.querySelectorAll(".service-page").forEach(function(page) {
                page.classList.remove("active-service");
            });

            // Show selected service
            const service = document.getElementById(serviceId);

            if (!service) {
                console.log("Service not found:", serviceId);
                return;
            }

            service.classList.add("active-service");

            // Close mobile menu
            document.getElementById("navbar").classList.remove("active");

            // Go to top
            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });
        }

        // MAIN PAGE NAVIGATION
        function showPage(pageId) {

            // Website pages require login.
            // Auth pages remain accessible without login.
            if (!isLoggedIn()) {
                if (pageId !== "loginPage" && pageId !== "signupPage") {
                    showAuthPage("login");
                    return;
                }
            }

            // Hide all normal pages
            document.querySelectorAll(".page").forEach(function(page) {
                page.classList.remove("active-page");
            });

            // Hide all service detail pages
            document.querySelectorAll(".service-page").forEach(function(page) {
                page.classList.remove("active-service");
            });

            const selectedPage = document.getElementById(pageId);

            if (!selectedPage) {
                console.log("Page not found:", pageId);
                return;
            }

            selectedPage.classList.add("active-page");

            // Close mobile menu
            document.getElementById("navbar").classList.remove("active");

            // Go to top
            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });
        }

        // MOBILE MENU
        function openMenu() {
            document.getElementById("navbar").classList.toggle("active");
        }

        // LIGHT / DARK MODE
        function toggleTheme() {
            document.body.classList.toggle("dark");

            const isDark = document.body.classList.contains("dark");

            // Save selected theme
            localStorage.setItem("techzoneTheme", isDark ? "dark" : "light");

            updateThemeButton();
        }

        // UPDATE BUTTON TEXT + ICON
        function updateThemeButton() {
            const themeBtn = document.getElementById("themeBtn");

            if (!themeBtn) return;

            if (document.body.classList.contains("dark")) {
                themeBtn.innerHTML = "☀️ Light";
            } else {
                themeBtn.innerHTML = "🌙 Dark";
            }
        }

        // LOAD SAVED THEME
        function loadTheme() {
            const savedTheme = localStorage.getItem("techzoneTheme");

            if (savedTheme === "dark") {
                document.body.classList.add("dark");
            } else {
                document.body.classList.remove("dark");
            }

            updateThemeButton();
        }

        // LOGIN OPEN
        function openLogin() {
            document.getElementById("loginModal").style.display = "flex";
        }

        // LOGIN CLOSE
        function closeLogin() {
            document.getElementById("loginModal").style.display = "none";
        }

        // LOGIN
        function login(event) {
            event.preventDefault();

            const email = event.target.querySelector('input[type="email"]').value;

            alert("Welcome to TechZone!\\nLogged in as: " + email);

            event.target.reset();
            closeLogin();
        }

        // CONTACT FORM
        function sendMessage(event) {
            event.preventDefault();

            const name = document.getElementById("name").value.trim();

            if (!name) {
                alert("Please enter your name.");
                return;
            }

            alert(
                "Thank you " +
                name +
                "! Your message has been sent successfully. ✅"
            );

            event.target.reset();
        }

        // CLOSE LOGIN WHEN CLICKING OUTSIDE
        window.addEventListener("click", function(event) {
            const modal = document.getElementById("loginModal");

            if (event.target === modal) {
                closeLogin();
            }
        });

        // ESC KEY CLOSES LOGIN
        window.addEventListener("keydown", function(event) {
            if (event.key === "Escape") {
                closeLogin();
            }
        });

        // CLOSE MOBILE MENU AFTER CLICKING A NAV LINK
        document.querySelectorAll("#navbar a").forEach(function(link) {
            link.addEventListener("click", function() {
                document.getElementById("navbar").classList.remove("active");
            });
        });

        // INITIALIZE WEBSITE
        document.addEventListener("DOMContentLoaded", function() {
            loadTheme();

            // Login is required before opening the website
            if (isLoggedIn()) {
                showPage("home");
            } else {
                showAuthPage("login");
            }
        });

    
/* ===== SAFE STARTUP ===== */
document.addEventListener("DOMContentLoaded", function(){
    try{
        if(typeof loadTheme === "function") loadTheme();
        if(typeof updateThemeButton === "function") updateThemeButton();
    }catch(e){ console.warn("Theme startup:",e); }
});

</script>

</body>
</html>
```
